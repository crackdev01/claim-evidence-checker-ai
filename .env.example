# Required for live assessments and the live part of the evaluation.
ANTHROPIC_API_KEY=

# Any Claude model that supports structured outputs, e.g. claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: effort level (low, medium, high, xhigh, max). Empty uses the model's default.
ANTHROPIC_EFFORT=

# Optional: output token limit for the structured assessment.
ANTHROPIC_MAX_TOKENS=16000

# Port for the API server. The Vite dev server proxies /api to it.
PORT=8787
